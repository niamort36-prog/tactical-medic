# Journaux et cache produits par le CLI Firebase
firebase-debug.log*
firebase-debug.*.log*
.firebase/

# Ne jamais versionner une cle de compte de service :
# elle vit dans les secrets GitHub, pas dans le depot.
*serviceAccount*.json
*-firebase-adminsdk-*.json

node_modules/

